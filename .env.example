# ── API Keys ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

# ── WhatsApp ──────────────────────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_ALLOWED_USERS=*

# ── Discord ───────────────────────────────────────────────────────
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_ALLOWED_USERS=your_discord_user_id

# ── Model Config ─────────────────────────────────────────────────
# Default model and provider
HERMES_MODEL=qwen/qwen3.7-flash
HERMES_PROVIDER=openrouter

# ── Custom Provider (e.g., 9router) ──────────────────────────────
# CUSTOM_PROVIDER_URL=http://100.100.12.34:20128/v1
# CUSTOM_PROVIDER_KEY=sk-your_key_here

# ── Tailscale (optional) ─────────────────────────────────────────
# TAILSCALE_AUTH_KEY=tskey-auth-your_key_here
