# ── API Keys ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

#SSH PORT
SSH_PORT=2222

# ── Discord ───────────────────────────────────────────────────────
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_ALLOWED_USERS=your_discord_user_id

# ── Model Config ─────────────────────────────────────────────────
HERMES_MODEL=qwen/qwen3.7-flash
HERMES_PROVIDER=openrouter

# ── Custom Ports ─────────────────────────────────────────────────
HERMES_DASHBOARD_PORT=5002

# ── SSH Access ───────────────────────────────────────────────────
# Option 1: Paste your public key here
# SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your@email.com

# Option 2: Mount ssh/authorized_keys file (preferred)
# Create ssh/authorized_keys with your public key
